//@version=6
indicator("YeĦ.btc", overlay = true)

const string TEXT_GROUP = "文字水印"
const string INFO_GROUP = "品种与日期"

textVertical = input.string("上", "垂直", options = ["上", "中", "下"], group = TEXT_GROUP, inline = "位置", display = display.none)
textHorizontal = input.string("右", "水平", options = ["左", "中", "右"], group = TEXT_GROUP, inline = "位置", display = display.none)
line1 = input.string("YeĦ.btc⚔️", "第一行", group = TEXT_GROUP, inline = "第一行", display = display.none)
color1 = input.color(color.white, "颜色", group = TEXT_GROUP, inline = "第一行", display = display.none)
line2 = input.string("Always long🧲💹", "第二行", group = TEXT_GROUP, inline = "第二行", display = display.none)
color2 = input.color(#4caf50, "颜色", group = TEXT_GROUP, inline = "第二行", display = display.none)
textSize = input.string("大", "字号", options = ["小", "标准", "大", "特大"], group = TEXT_GROUP, display = display.none)
showConversion = input.bool(false, "显示换算", group = TEXT_GROUP, inline = "换算", display = display.none)
conversionAmount = input.float(100, "报价币金额", minval = 0, group = TEXT_GROUP, inline = "换算", active = showConversion, display = display.none)

showSymbol = input.bool(true, "品种与周期", group = INFO_GROUP, inline = "显示", display = display.none)
showDate = input.bool(true, "日期与时间", group = INFO_GROUP, inline = "显示", display = display.none)
showWeekday = input.bool(true, "星期", group = INFO_GROUP, inline = "显示", display = display.none)
infoVertical = input.string("下", "垂直", options = ["上", "中", "下"], group = INFO_GROUP, inline = "位置", display = display.none)
infoHorizontal = input.string("右", "水平", options = ["左", "中", "右"], group = INFO_GROUP, inline = "位置", display = display.none)
infoSize = input.string("大", "字号", options = ["小", "标准", "大", "特大"], group = INFO_GROUP, inline = "样式", display = display.none)
infoColor = input.color(#b8b8b8, "颜色", group = INFO_GROUP, inline = "样式", display = display.none)
timeZone = input.string("GMT+8", "时区", group = INFO_GROUP, tooltip = "例如 GMT+8、UTC 或 America/New_York。", display = display.none)

anchor(string vertical, string horizontal) =>
    string row = vertical == "上" ? "top" : vertical == "下" ? "bottom" : "middle"
    string column = horizontal == "左" ? "left" : horizontal == "右" ? "right" : "center"
    row + "_" + column

fontSize(string setting) =>
    switch setting
        "小" => size.small
        "标准" => size.normal
        "特大" => size.huge
        => size.large

// 左右各留出 1% 图表宽度，上下各留一行。
addPadding(table watermark, int bottomRow, string setting) =>
    table.cell(watermark, 0, 0, " ", width = 1, text_size = fontSize(setting))
    table.cell(watermark, 2, bottomRow, " ", width = 1, text_size = fontSize(setting))

weekdayName(int timestamp) =>
    switch dayofweek(timestamp, timeZone)
        dayofweek.monday => "星期一"
        dayofweek.tuesday => "星期二"
        dayofweek.wednesday => "星期三"
        dayofweek.thursday => "星期四"
        dayofweek.friday => "星期五"
        dayofweek.saturday => "星期六"
        => "星期日"

textAnchor = anchor(textVertical, textHorizontal)
infoAnchor = anchor(infoVertical, infoHorizontal)
sameAnchor = textAnchor == infoAnchor
var table textWatermark = table.new(textAnchor, 3, sameAnchor ? 7 : 5)
var table infoWatermark = sameAnchor ? textWatermark : table.new(infoAnchor, 3, 4)

if barstate.islast
    addPadding(textWatermark, sameAnchor ? 6 : 4, textSize)
    if not sameAnchor
        addPadding(infoWatermark, 3, infoSize)
    table.cell(textWatermark, 1, 1, line1, text_color = color1, text_size = fontSize(textSize))
    table.cell(textWatermark, 1, 2, line2, text_color = color2, text_size = fontSize(textSize))

    if showConversion
        string currency = syminfo.currency
        bool canConvert = currency != "" and currency != "NONE" and close > 0
        string conversionText = "换算不可用"
        if canConvert
            float quantity = conversionAmount / close
            string quantityText = quantity > 0 and quantity < 0.000000000001 ? "< 0.000000000001" : str.tostring(quantity, "0.############")
            string unit = syminfo.basecurrency == "" ? syminfo.ticker : syminfo.basecurrency
            conversionText := str.tostring(conversionAmount, "0.############") + " " + currency + " → " + quantityText + " " + unit
        table.cell(textWatermark, 1, 3, conversionText, text_color = color1, text_size = fontSize(textSize))

    int infoRow = sameAnchor ? 4 : 1
    if showSymbol
        string period = timeframe.period
        if timeframe.isminutes
            int minutes = timeframe.multiplier
            period := minutes % 60 == 0 ? str.tostring(minutes / 60) + "h" : str.tostring(minutes) + "m"
        table.cell(infoWatermark, 1, infoRow, syminfo.ticker + " | " + period, text_color = infoColor, text_size = fontSize(infoSize))

    if showDate
        int timestamp = timenow >= time and (na(time_close) ? barstate.isrealtime : timenow < time_close) ? timenow : time
        string dateText = str.format_time(timestamp, "yyyy/M/d", timeZone)
        string weekday = showWeekday ? " " + weekdayName(timestamp) : ""
        string clockText = str.format_time(timestamp, "HH:mm", timeZone)
        table.cell(infoWatermark, 1, infoRow + 1, dateText + weekday + " " + clockText, text_color = infoColor, text_size = fontSize(infoSize))
