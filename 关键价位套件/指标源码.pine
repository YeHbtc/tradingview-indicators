historyTag(string choice) =>
    choice == "pp" ? "pp" : prevTag

periodCode(string choice) =>
    switch choice
        FOUR_H => "240"
        DAY_TF => "1D"
        WEEK_TF => "1W"
        MONTH_TF => "1M"
        QUARTER_TF => "3M"
        => "12M"

periodTag(string choice) =>
    switch choice
        FOUR_H => fourTag
        DAY_TF => dayTag
        WEEK_TF => weekTag
        MONTH_TF => monthTag
        QUARTER_TF => quarterTag
        => yearTag

dayNumber(string choice) =>
    switch choice
        "星期一" => dayofweek.monday
        "星期二" => dayofweek.tuesday
        "星期三" => dayofweek.wednesday
        "星期四" => dayofweek.thursday
        "星期五" => dayofweek.friday
        "星期六" => dayofweek.saturday
        => dayofweek.sunday

dayName(int number) =>
    switch number
        dayofweek.monday => dyTag0
        dayofweek.tuesday => dyTag1
        dayofweek.wednesday => dyTag2
        dayofweek.thursday => dyTag3
        dayofweek.friday => dyTag4
        dayofweek.saturday => dyTag5
        => dyTag6

type Level
    float price
    string title
    color shade
    int start

var array<Level> levels = array.new<Level>()
var array<line> drawnLines = array.new<line>()
var array<label> drawnLabels = array.new<label>()

emitLevel(bool enabled, float price, string title, color shade, int origin) =>
    if barstate.islast and enabled and not na(price)
        bool merged = false
        if mergeLevels and array.size(levels) > 0
            for item in levels
                float tolerance = math.abs(item.price) * overlapPct / 100
                if math.abs(item.price - price) <= tolerance
                    item.title := item.title + " / " + title
                    item.shade := mergeColor
                    item.start := math.min(item.start, origin)
                    merged := true
                    break
        if not merged
            array.push(levels, Level.new(price, title, shade, origin))
    0

emitRange(bool useOpen, bool useHigh, bool useLow, bool useMid, float o, float h, float l, string prefix, color shade, int origin) =>
    emitLevel(useOpen, o, prefix + openTag, shade, origin)
    emitLevel(useHigh, h, prefix + highTag, shade, origin)
    emitLevel(useLow, l, prefix + lowTag, shade, origin)
    emitLevel(useMid, (h + l) / 2, prefix + midTag, shade, origin)

higherLevels(string choice, string history, color shade, bool co, bool ch, bool cl, bool cm, bool po, bool ph, bool pl, bool pm) =>
    string tf = periodCode(choice)
    if enableHTF and (co or ch or cl or cm or po or ph or pl or pm) and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        [o, priorO, priorH, priorL, olderO, olderH, olderL] = request.security(syminfo.tickerid, tf, [open, open[1], high[1], low[1], open[2], high[2], low[2]], lookahead = barmerge.lookahead_on)
        bool reset = timeframe.change(tf)
        var float runningHigh = na
        var float runningLow = na
        var int origin = bar_index
        var int priorOrigin = bar_index
        var int olderOrigin = bar_index
        if reset or na(runningHigh)
            olderOrigin := priorOrigin
            priorOrigin := origin
            origin := bar_index
            runningHigh := high
            runningLow := low
        else
            runningHigh := math.max(runningHigh, high)
            runningLow := math.min(runningLow, low)
        emitRange(co, ch, cl, cm, o, runningHigh, runningLow, periodTag(choice), shade, origin)
        bool older = history == "pp"
        emitRange(po, ph, pl, pm, older ? olderO : priorO, older ? olderH : priorH, older ? olderL : priorL, historyTag(history) + periodTag(choice), shade, older ? olderOrigin : priorOrigin)
    0

emitVwap(bool meanOn, bool deviationOn, float mean, float sd, string prefix, color shade, int origin) =>
    emitLevel(meanOn, mean, prefix + vwapTag, shade, origin)
    emitLevel(deviationOn, mean + sd, prefix + vwapTag + "+1σ", shade, origin)
    emitLevel(deviationOn, mean - sd, prefix + vwapTag + "−1σ", shade, origin)

vwapLevels(string choice, string history, color shade, bool cv, bool cs, bool pv, bool ps) =>
    string tf = periodCode(choice)
    if enableVWAP and (cv or cs or pv or ps) and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        bool reset = timeframe.change(tf)
        [mean, upper, lower] = ta.vwap(hlc3, reset or barstate.isfirst, 1)
        var float priorMean = na
        var float priorSd = na
        var int origin = bar_index
        var int priorOrigin = bar_index
        var float olderMean = na
        var float olderSd = na
        var int olderOrigin = bar_index
        if reset
            olderMean := priorMean
            olderSd := priorSd
            olderOrigin := priorOrigin
            priorMean := mean[1]
            priorSd := upper[1] - mean[1]
            priorOrigin := origin
            origin := bar_index
        emitVwap(cv, cs, mean, upper - mean, periodTag(choice), shade, origin)
        bool older = history == "pp"
        emitVwap(pv, ps, older ? olderMean : priorMean, older ? olderSd : priorSd, historyTag(history) + periodTag(choice), shade, older ? olderOrigin : priorOrigin)
    0

averageLevels(int length, color shade, bool simpleOn, bool exponentialOn) =>
    float simple = ta.sma(close, length)
    float exponential = ta.ema(close, length)
    emitLevel(enableMA and simpleOn, simple, str.tostring(length) + " SMA", shade, bar_index - offsetLeft)
    emitLevel(enableMA and exponentialOn, exponential, str.tostring(length) + " EMA", shade, bar_index - offsetLeft)

sessionLevels(string hours, string history, string zone, string prefix, color shade, bool co, bool ch, bool cl, bool cm, bool po, bool ph, bool pl, bool pm) =>
    if enableSESSION and timeframe.isintraday and (co or ch or cl or cm or po or ph or pl or pm)
        bool inside = not na(time(timeframe.period, hours + ":1234567", zone))
        int sessionStart = time("1D", hours + ":1234567", zone)
        bool begins = inside and (not inside[1] or sessionStart != sessionStart[1])
        var float so = na
        var float sh = na
        var float sl = na
        var float priorO = na
        var float priorH = na
        var float priorL = na
        var int origin = bar_index
        var int priorOrigin = bar_index
        var float olderO = na
        var float olderH = na
        var float olderL = na
        var int olderOrigin = bar_index
        if begins
            olderO := priorO
            olderH := priorH
            olderL := priorL
            olderOrigin := priorOrigin
            priorO := so
            priorH := sh
            priorL := sl
            priorOrigin := origin
            so := open
            sh := high
            sl := low
            origin := bar_index
        else if inside
            sh := math.max(sh, high)
            sl := math.min(sl, low)
        emitRange(co, ch, cl, cm, so, sh, sl, prefix, shade, origin)
        bool older = history == "pp"
        emitRange(po, ph, pl, pm, older ? olderO : priorO, older ? olderH : priorH, older ? olderL : priorL, historyTag(history) + prefix, shade, older ? olderOrigin : priorOrigin)
    0

dayLevels(string choice, color shade, bool co, bool ch, bool cl, bool cm) =>
    if enableDAY and timeframe.in_seconds() <= timeframe.in_seconds("1D") and (co or ch or cl or cm)
        int number = dayNumber(choice)
        int sessionDay = dayofweek(time_tradingday, "UTC")
        var float so = na
        var float sh = na
        var float sl = na
        var int origin = bar_index
        if sessionDay == number
            if time_tradingday != time_tradingday[1] or na(so)
                so := open
                sh := high
                sl := low
                origin := bar_index
            else
                sh := math.max(sh, high)
                sl := math.min(sl, low)
        emitRange(co, ch, cl, cm, so, sh, sl, dayName(number), shade, origin)
    0

// 将每根 K 线成交量分配到其典型价格对应的区间，再从 POC 向两侧扩展价值区。
profile(array<float> prices, array<float> volumes) =>
    float poc = na
    float vah = na
    float val = na
    if array.size(prices) > 0
        float lowPrice = array.min(prices)
        float highPrice = array.max(prices)
        float step = (highPrice - lowPrice) / profileRows
        if step == 0
            poc := lowPrice
            vah := lowPrice
            val := lowPrice
        else
            array<float> bins = array.new_float(profileRows, 0)
            for [i, price] in prices
                int index = math.min(profileRows - 1, int(math.floor((price - lowPrice) / step)))
                array.set(bins, index, array.get(bins, index) + array.get(volumes, i))
            int center = array.indexof(bins, array.max(bins))
            int left = center
            int right = center
            float covered = array.get(bins, center)
            float target = array.sum(bins) * valueArea / 100
            while covered < target and (left > 0 or right < profileRows - 1)
                float below = left > 0 ? array.get(bins, left - 1) : -1
                float above = right < profileRows - 1 ? array.get(bins, right + 1) : -1
                if above > below
                    right += 1
                    covered += above
                else
                    left -= 1
                    covered += below
            poc := lowPrice + (center + 0.5) * step
            vah := lowPrice + (right + 1) * step
            val := lowPrice + left * step
    [poc, vah, val]

emitProfile(bool pocOn, bool vaOn, float poc, float vah, float val, string prefix, color shade, int origin) =>
    emitLevel(pocOn, poc, prefix + "POC", shade, origin)
    emitLevel(vaOn, vah, prefix + "VAH", shade, origin)
    emitLevel(vaOn, val, prefix + "VAL", shade, origin)

profileLevels(string choice, string history, color shade, bool cp, bool ca, bool pp, bool pa) =>
    string tf = periodCode(choice)
    if enablePROFILE and (cp or ca or pp or pa) and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        var array<float> prices = array.new_float()
        var array<float> volumes = array.new_float()
        var int origin = bar_index
        var int priorOrigin = bar_index
        var float priorPoc = na
        var float priorVah = na
        var float priorVal = na
        var float olderPoc = na
        var float olderVah = na
        var float olderVal = na
        var int olderOrigin = bar_index
        if timeframe.change(tf)
            olderPoc := priorPoc
            olderVah := priorVah
            olderVal := priorVal
            olderOrigin := priorOrigin
            if pp or pa
                [poc, vah, val] = profile(prices, volumes)
                priorPoc := poc
                priorVah := vah
                priorVal := val
            array.clear(prices)
            array.clear(volumes)
            priorOrigin := origin
            origin := bar_index
        int capacity = fastProfile ? 1500 : 6000
        if not na(volume) and volume > 0
            if array.size(prices) >= capacity
                array.shift(prices)
                array.shift(volumes)
            array.push(prices, hlc3)
            array.push(volumes, volume)
        if barstate.islast
            if cp or ca
                [poc, vah, val] = profile(prices, volumes)
                emitProfile(cp, ca, poc, vah, val, periodTag(choice), shade, origin)
            bool older = history == "pp"
            emitProfile(pp, pa, older ? olderPoc : priorPoc, older ? olderVah : priorVah, older ? olderVal : priorVal, historyTag(history) + periodTag(choice), shade, older ? olderOrigin : priorOrigin)
    0

if barstate.islast
    array.clear(levels)

higherLevels(ht0Tf, ht0History, ht0Color, ht0O, ht0H, ht0L, ht0M, ht0PrevO, ht0PrevH, ht0PrevL, ht0PrevM)
higherLevels(ht1Tf, ht1History, ht1Color, ht1O, ht1H, ht1L, ht1M, ht1PrevO, ht1PrevH, ht1PrevL, ht1PrevM)
higherLevels(ht2Tf, ht2History, ht2Color, ht2O, ht2H, ht2L, ht2M, ht2PrevO, ht2PrevH, ht2PrevL, ht2PrevM)
higherLevels(ht3Tf, ht3History, ht3Color, ht3O, ht3H, ht3L, ht3M, ht3PrevO, ht3PrevH, ht3PrevL, ht3PrevM)
vwapLevels(vw0Tf, vw0History, vw0Color, vw0Vwap, vw0Sd, vw0PrevVwap, vw0PrevSd)
vwapLevels(vw1Tf, vw1History, vw1Color, vw1Vwap, vw1Sd, vw1PrevVwap, vw1PrevSd)
vwapLevels(vw2Tf, vw2History, vw2Color, vw2Vwap, vw2Sd, vw2PrevVwap, vw2PrevSd)
averageLevels(ma0Len, ma0Color, ma0Sma, ma0Ema)
averageLevels(ma1Len, ma1Color, ma1Sma, ma1Ema)
averageLevels(ma2Len, ma2Color, ma2Sma, ma2Ema)
sessionLevels(ss0Hours, ss0History, tz0, ss0Tag, ss0Color, ss0O, ss0H, ss0L, ss0M, ss0PrevO, ss0PrevH, ss0PrevL, ss0PrevM)
sessionLevels(ss1Hours, ss1History, tz1, ss1Tag, ss1Color, ss1O, ss1H, ss1L, ss1M, ss1PrevO, ss1PrevH, ss1PrevL, ss1PrevM)
sessionLevels(ss2Hours, ss2History, tz2, ss2Tag, ss2Color, ss2O, ss2H, ss2L, ss2M, ss2PrevO, ss2PrevH, ss2PrevL, ss2PrevM)
profileLevels(vp0Tf, vp0History, vp0Color, vp0Poc, vp0Va, vp0PrevPoc, vp0PrevVa)
profileLevels(vp1Tf, vp1History, vp1Color, vp1Poc, vp1Va, vp1PrevPoc, vp1PrevVa)
profileLevels(vp2Tf, vp2History, vp2Color, vp2Poc, vp2Va, vp2PrevPoc, vp2PrevVa)
dayLevels(dy0Day, dy0Color, dy0O, dy0H, dy0L, dy0M)
dayLevels(dy1Day, dy1Color, dy1O, dy1H, dy1L, dy1M)
dayLevels(dy2Day, dy2Color, dy2O, dy2H, dy2L, dy2M)

if barstate.islast
    for oldLine in drawnLines
        line.delete(oldLine)
    for oldLabel in drawnLabels
        label.delete(oldLabel)
    array.clear(drawnLines)
    array.clear(drawnLabels)
    string style = lineStyle == "虚线" ? line.style_dashed : lineStyle == "点线" ? line.style_dotted : line.style_solid
    string extension = switch lineType
        "向左延伸" => extend.left
        "向右延伸" => extend.right
        "双向延伸" => extend.both
        => extend.none
    string labelFont = fontStyle == "等宽" ? font.family_monospace : font.family_default
    string textSize = switch labelSize
        "极小" => size.tiny
        "小" => size.small
        "大" => size.large
        "特大" => size.huge
        => size.normal
    int end = bar_index + offsetRight
    for item in levels
        color shade = overrideColors ? overrideColor : item.shade
        int start = math.max(0, bar_index - 9999, item.start - offsetLeft)
        array.push(drawnLines, line.new(start, item.price, end, item.price, extend = extension, color = shade, style = style, width = lineWidth))
        string caption = showName ? item.title : ""
        if showPrice
            caption += (caption == "" ? "" : " · ") + str.tostring(item.price, format.mintick)
        if showDistance and close != 0
            caption += (caption == "" ? "" : " · ") + str.tostring((item.price - close) / close * 100, "0.00") + "%"
        if caption != ""
            array.push(drawnLabels, label.new(end + 2, item.price, caption, style = label.style_label_left, color = color.new(shade, 100), textcolor = shade, size = textSize, text_font_family = labelFont))
