// Volume Weighted Average Price for multiple periods with Standard Deviation band selection - Daily, Weekly, Monthly, Quarterly, Yearly


// 中文设置与默认样式调整。
indicator("VWAP D/W/M/Q/Y", overlay = true)

const color VWAP_RED = #f23645

// ---------- Functions ---------- //

// TradingView vwap function. Taken out stdev calcs to put in seperate function.
computeVWAP(src, isNewPeriod) =>
    var float sumSrcVol = na
    var float sumVol = na
    var float sumSrcSrcVol = na

    sumSrcVol := (isNewPeriod or barstate.isfirst) ? src * volume : src * volume + sumSrcVol[1]
    sumVol := (isNewPeriod or barstate.isfirst) ? volume : volume + sumVol[1]
    // sumSrcSrcVol calculates the dividend of the equation that is later used to calculate the standard deviation
    sumSrcSrcVol := isNewPeriod ? volume * math.pow(src, 2) : volume * math.pow(src, 2) + sumSrcSrcVol[1]

    _vwap = sumSrcVol / sumVol
    variance = sumSrcSrcVol / sumVol - math.pow(_vwap, 2)
    variance := variance < 0 ? 0 : variance
    stDev = math.sqrt(variance)

    [_vwap, stDev]

// Standard Deviation Band calculation function
compute_stDEV(_vwap, stDev, stDevMultiplier_1, stDevMultiplier_2) =>

    upperBand_2 = _vwap + stDev * stDevMultiplier_2
    upperBand_1 = _vwap + stDev * stDevMultiplier_1
    lowerBand_1 = _vwap - stDev * stDevMultiplier_1
    lowerBand_2 = _vwap - stDev * stDevMultiplier_2

    [upperBand_2, upperBand_1, lowerBand_1, lowerBand_2]

// Label function from sbtnc - Daily Weekly Monthly Opens script
f_drawLabel(_x, _y, _text, _textcolor, _style, _size) =>
    var _label = label.new(
     x          = _x,
     y          = _y,
     text       = _text,
     textcolor  = _textcolor,
     style      = _style,
     size       = _size,
     xloc       = xloc.bar_time
     )

    label.set_xy(_label, _x, _y)
    label.set_text(_label, na(_y) ? "" : str.trim(_text) + " · " + str.tostring(_y, format.mintick))

// ---------- VWAP selection ---------- //

src = input.source(hlc3, "VWAP 价格来源", group = "VWAP 周期", display = display.none)

plot_vD = input.bool(false, "日线 VWAP", group = "VWAP 周期", display = display.none)
plot_vW = input.bool(true, "周线 VWAP", group = "VWAP 周期", display = display.none)
plot_vM = input.bool(false, "月线 VWAP", group = "VWAP 周期", display = display.none)
plot_vQ = input.bool(false, "季线 VWAP", group = "VWAP 周期", display = display.none)
plot_vY = input.bool(false, "年线 VWAP", group = "VWAP 周期", display = display.none)

showStd = input.bool(true, "标准差", group = "本期标准差", display = display.none)
Std_selection = input.string("周线", "标准差周期", options = ["日线", "周线", "月线", "季线", "年线"], group = "本期标准差", display = display.none)

showBand1 = input.bool(true, "±1σ", group = "本期标准差", inline = "标准差 1", display = display.none)
stDevMultiplier_1 = input.float(1.0, "标准差倍数 1", group = "本期标准差", inline = "标准差 1", display = display.none)
showBand2 = input.bool(false, "±2σ", group = "本期标准差", inline = "标准差 2", display = display.none)
stDevMultiplier_2 = input.float(2.0, "标准差倍数 2", group = "本期标准差", inline = "标准差 2", display = display.none)

show_labels = input.bool(false, "本期标签", group = "窗格标签", display = display.none)
fill_bands = input.bool(true, "填充本期区间", group = "本期标准差", display = display.none)

plot_pL1 = input.bool(true, "上期 VWAP 和 ±1", group = "上期区间", display = display.none)
plot_pL2 = input.bool(true, "上期 ±2", group = "上期区间", display = display.none)

show_plabels = input.bool(false, "上期标签", group = "窗格标签", display = display.none)
fill_pbands = input.bool(true, "填充上期区间", group = "上期区间", display = display.none)

off_mult = input.int(15, "标签偏移", group = "窗格标签", display = display.none)
bandColor1 = input.color(color.new(#9c9c9c, 56), "±1σ", group = "标准差颜色", inline = "颜色", display = display.none)
bandColor2 = input.color(color.new(#9c9c9c, 68), "±2σ", group = "标准差颜色", inline = "颜色", display = display.none)
bandFill = input.color(color.new(#9c9c9c, 76), "背景", group = "标准差颜色", inline = "颜色", display = display.none)

var DEFAULT_LABEL_SIZE      = size.small
var DEFAULT_LABEL_STYLE     = label.style_none
ll_offset = timenow + math.round(ta.change(time)*off_mult)

// ---------- VWAP Calculations ---------- //

timeChange(period) =>
    ta.change(time(period))

newSessionD = timeChange("D")
newSessionW = timeChange("W")
newSessionM = timeChange("M")
newSessionQ = timeChange("3M")
newSessionY = timeChange("12M")


// ---------- VWAP Function Calls ---------- //

[vD, stdevD] = computeVWAP(src, newSessionD)
[vW, stdevW] = computeVWAP(src, newSessionW)
[vM, stdevM] = computeVWAP(src, newSessionM)
[vQ, stdevQ] = computeVWAP(src, newSessionQ)
[vY, stdevY] = computeVWAP(src, newSessionY)




// ---------- Plot VWAPs ---------- //

vDplot = plot(plot_vD ? vD : na, title = "本期 · 日 VWAP", color = VWAP_RED, style = plot.style_line, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_labels and plot_vD ? vD : na, "--------- vD   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vWplot = plot(plot_vW ? vW : na, title = "本期 · 周 VWAP", color = VWAP_RED, style = plot.style_line, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_labels and plot_vW ? vW : na, "--------- vW   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vMplot = plot(plot_vM ? vM : na, title = "本期 · 月 VWAP", color = VWAP_RED, style = plot.style_line, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_labels and plot_vM ? vM : na, "--------- vM   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vQplot = plot(plot_vQ ? vQ : na, title = "本期 · 季 VWAP", color = VWAP_RED, style = plot.style_line, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_labels and plot_vQ ? vQ : na, "--------- vQ   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vYplot = plot(plot_vY ? vY : na, title = "本期 · 年 VWAP", color = VWAP_RED, style = plot.style_line, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_labels and plot_vY ? vY : na, "--------- vY   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)


// ---------- Standard Deviation Calc ---------- //

stdev_sel = Std_selection == "日线" ? stdevD :
         Std_selection == "周线" ? stdevW :
         Std_selection == "月线" ? stdevM :
         Std_selection == "季线" ? stdevQ :
         Std_selection == "年线" ? stdevY : na

vwap_sel = Std_selection == "日线" ? vD :
         Std_selection == "周线" ? vW :
         Std_selection == "月线" ? vM :
         Std_selection == "季线" ? vQ :
         Std_selection == "年线" ? vY : na

prev_period = Std_selection == "日线" ? newSessionD :
         Std_selection == "周线" ? newSessionW :
         Std_selection == "月线" ? newSessionM :
         Std_selection == "季线" ? newSessionQ :
         Std_selection == "年线" ? newSessionY : na

[s2up, s1up, s1dn, s2dn] = compute_stDEV(vwap_sel, stdev_sel, stDevMultiplier_1, stDevMultiplier_2)

a = plot(showStd and showBand2 ? s2up : na, title = "本期 · +2σ", color = bandColor2, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_labels and showStd and showBand2 ? s2up : na , "     -------- SD+2   ", bandColor2, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

b = plot(showStd and showBand1 ? s1up : na, title = "本期 · +1σ", color = bandColor1, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_labels and showStd and showBand1 ? s1up : na , "     -------- SD+1   ", bandColor1, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

c = plot(showStd and showBand1 ? s1dn : na, title = "本期 · −1σ", color = bandColor1, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_labels and showStd and showBand1 ? s1dn : na , "     -------- SD-1   ", bandColor1, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

d = plot(showStd and showBand2 ? s2dn : na, title = "本期 · −2σ", color = bandColor2, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_labels and showStd and showBand2 ? s2dn : na , "     -------- SD-2   ", bandColor2, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

currentUpper = plot(showStd ? (showBand2 ? s2up : showBand1 ? s1up : na) : na, display = display.none, editable = false)
currentLower = plot(showStd ? (showBand2 ? s2dn : showBand1 ? s1dn : na) : na, display = display.none, editable = false)
fill(currentUpper, currentLower, fill_bands ? bandFill : na, title = "本期 · 标准差背景", fillgaps = false, editable = false)

// ---------- Previous period levels ---------- //

previouslevels(period, VWAP, s2up, s1up, s1dn, s2dn) =>
    var float pV = na
    var float ps2up = na
    var float ps1up = na
    var float ps1dn = na
    var float ps2dn = na
    pV := period ? VWAP[1] : pV
    ps2up := period ? s2up[1] : ps2up
    ps1up := period ? s1up[1] : ps1up
    ps1dn := period ? s1dn[1] : ps1dn
    ps2dn := period ? s2dn[1] : ps2dn

    [ pV, ps2up, ps1up, ps1dn, ps2dn ]

[ pV, ps2up, ps1up, ps1dn, ps2dn ] = previouslevels(prev_period, vwap_sel, s2up, s1up, s1dn, s2dn)

// ---------- Plot previous levels ---------- //

pVplot = plot(plot_pL1 ? pV : na, title = "上期 · VWAP", color = color.new(VWAP_RED, 60), style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window)
f_drawLabel(ll_offset, show_plabels and plot_pL1 ? pV : na, "--------- pVWAP   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pa = plot(plot_pL2 and showBand2 ? ps2up : na, title = "上期 · +2σ", color = bandColor2, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_plabels and plot_pL2 and showBand2 ? ps2up : na , "     -------- pSD+2   ", bandColor2, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pb = plot(plot_pL1 and showBand1 ? ps1up : na, title = "上期 · +1σ", color = bandColor1, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_plabels and plot_pL1 and showBand1 ? ps1up : na , "     -------- pSD+1   ", bandColor1, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pc = plot(plot_pL1 and showBand1 ? ps1dn : na, title = "上期 · −1σ", color = bandColor1, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_plabels and plot_pL1 and showBand1 ? ps1dn : na , "     -------- pSD-1   ", bandColor1, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pd = plot(plot_pL2 and showBand2 ? ps2dn : na, title = "上期 · −2σ", color = bandColor2, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window, editable = false)
f_drawLabel(ll_offset, show_plabels and plot_pL2 and showBand2 ? ps2dn : na , "     -------- pSD-2   ", bandColor2, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

previousUpper = plot(plot_pL2 and showBand2 ? ps2up : plot_pL1 and showBand1 ? ps1up : na, display = display.none, editable = false)
previousLower = plot(plot_pL2 and showBand2 ? ps2dn : plot_pL1 and showBand1 ? ps1dn : na, display = display.none, editable = false)
fill(previousUpper, previousLower, fill_pbands ? bandFill : na, title = "上期 · 标准差背景", fillgaps = false, editable = false)
