// Volume Weighted Average Price for multiple periods with Standard Deviation band selection - Daily, Weekly, Monthly, Quarterly, Yearly


// 中文设置与默认样式调整。
indicator("Koalafied VWAP D/W/M/Q/Y", overlay = true)

const color VWAP_RED = #f23645

// ---------- Functions ---------- //

// TradingView vwap function. Taken out stdev calcs to put in seperate function.
computeVWAP(src, isNewPeriod) =>
    var float sumSrcVol = na
    var float sumVol = na
    var float sumSrcSrcVol = na

    sumSrcVol := (isNewPeriod or barstate.isfirst) ? src * volume : src * volume + sumSrcVol[1]
    sumVol := (isNewPeriod or barstate.isfirst) ? volume : volume + sumVol[1]
    // sumSrcSrcVol calculates the dividend of the equation that is later used to calculate the standard deviation
    sumSrcSrcVol := isNewPeriod ? volume * math.pow(src, 2) : volume * math.pow(src, 2) + sumSrcSrcVol[1]

    _vwap = sumSrcVol / sumVol
    variance = sumSrcSrcVol / sumVol - math.pow(_vwap, 2)
    variance := variance < 0 ? 0 : variance
    stDev = math.sqrt(variance)

    [_vwap, stDev]

// Standard Deviation Band calculation function
compute_stDEV(_vwap, stDev, stDevMultiplier_1, stDevMultiplier_2) =>

    upperBand_2 = _vwap + stDev * stDevMultiplier_2
    upperBand_1 = _vwap + stDev * stDevMultiplier_1
    lowerBand_1 = _vwap - stDev * stDevMultiplier_1
    lowerBand_2 = _vwap - stDev * stDevMultiplier_2

    [upperBand_2, upperBand_1, lowerBand_1, lowerBand_2]

// Label function from sbtnc - Daily Weekly Monthly Opens script
f_drawLabel(_x, _y, _text, _textcolor, _style, _size) =>
    var _label = label.new(
     x          = _x,
     y          = _y,
     text       = _text,
     textcolor  = _textcolor,
     style      = _style,
     size       = _size,
     xloc       = xloc.bar_time
     )

    label.set_xy(_label, _x, _y)

// ---------- VWAP selection ---------- //

src = input.source(hlc3, "VWAP 价格来源", display = display.none)

plot_vD = input.bool(false, "显示日线 VWAP", display = display.none)
plot_vW = input.bool(true, "显示周线 VWAP", display = display.none)
plot_vM = input.bool(false, "显示月线 VWAP", display = display.none)
plot_vQ = input.bool(false, "显示季线 VWAP", display = display.none)
plot_vY = input.bool(false, "显示年线 VWAP", display = display.none)

showStd = input.bool(true, "显示标准差", display = display.none)
Std_selection = input.string("周线", "标准差周期", options = ["日线", "周线", "月线", "季线", "年线"], display = display.none)

stDevMultiplier_1 = input.float(1.0, "标准差倍数 1", display = display.none)
stDevMultiplier_2 = input.float(1.0, "标准差倍数 2", display = display.none)

show_labels = input.bool(true, "显示本期标签", display = display.none)
fill_bands = input.bool(true, "填充本期区间", display = display.none)

plot_pL1 = input.bool(true, "显示上期 VWAP 和 ±1", display = display.none)
plot_pL2 = input.bool(true, "显示上期 ±2", display = display.none)

show_plabels = input.bool(true, "显示上期标签", display = display.none)
fill_pbands = input.bool(true, "填充上期区间", display = display.none)

off_mult = input.int(15, "标签偏移", display = display.none)
var DEFAULT_LABEL_SIZE      = size.small
var DEFAULT_LABEL_STYLE     = label.style_none
ll_offset = timenow + math.round(ta.change(time)*off_mult)

// ---------- VWAP Calculations ---------- //

timeChange(period) =>
    ta.change(time(period))

newSessionD = timeChange("D")
newSessionW = timeChange("W")
newSessionM = timeChange("M")
newSessionQ = timeChange("3M")
newSessionY = timeChange("12M")


// ---------- VWAP Function Calls ---------- //

[vD, stdevD] = computeVWAP(src, newSessionD)
[vW, stdevW] = computeVWAP(src, newSessionW)
[vM, stdevM] = computeVWAP(src, newSessionM)
[vQ, stdevQ] = computeVWAP(src, newSessionQ)
[vY, stdevY] = computeVWAP(src, newSessionY)




// ---------- Plot VWAPs ---------- //

vDplot = plot(plot_vD ? vD : na, title = "VWAP - Daily", color = VWAP_RED, style = plot.style_line, linewidth = 1)
f_drawLabel(ll_offset, show_labels and plot_vD ? vD : na, "--------- vD   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vWplot = plot(plot_vW ? vW : na, title = "VWAP - Weekly", color = VWAP_RED, style = plot.style_line, linewidth = 1)
f_drawLabel(ll_offset, show_labels and plot_vW ? vW : na, "--------- vW   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vMplot = plot(plot_vM ? vM : na, title = "VWAP - Monthly", color = VWAP_RED, style = plot.style_line, linewidth = 1)
f_drawLabel(ll_offset, show_labels and plot_vM ? vM : na, "--------- vM   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vQplot = plot(plot_vQ ? vQ : na, title = "VWAP - Quarter", color = VWAP_RED, style = plot.style_line, linewidth = 1)
f_drawLabel(ll_offset, show_labels and plot_vQ ? vQ : na, "--------- vQ   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

vYplot = plot(plot_vY ? vY : na, title = "VWAP - Year", color = VWAP_RED, style = plot.style_line, linewidth = 1)
f_drawLabel(ll_offset, show_labels and plot_vY ? vY : na, "--------- vY   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)


// ---------- Standard Deviation Calc ---------- //

stdev_sel = Std_selection == "日线" ? stdevD :
         Std_selection == "周线" ? stdevW :
         Std_selection == "月线" ? stdevM :
         Std_selection == "季线" ? stdevQ :
         Std_selection == "年线" ? stdevY : na

vwap_sel = Std_selection == "日线" ? vD :
         Std_selection == "周线" ? vW :
         Std_selection == "月线" ? vM :
         Std_selection == "季线" ? vQ :
         Std_selection == "年线" ? vY : na

prev_period = Std_selection == "日线" ? newSessionD :
         Std_selection == "周线" ? newSessionW :
         Std_selection == "月线" ? newSessionM :
         Std_selection == "季线" ? newSessionQ :
         Std_selection == "年线" ? newSessionY : na

[s2up, s1up, s1dn, s2dn] = compute_stDEV(vwap_sel, stdev_sel, stDevMultiplier_1, stDevMultiplier_2)

a = plot(showStd ? s2up : na, title = "VWAP - STDEV +2", color = color.new(color.gray, 70), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_labels and showStd ?  s2up : na , "     -------- SD+2   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

b = plot(showStd ? s1up : na, title = "VWAP - STDEV +1", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_labels and showStd ?  s1up : na , "     -------- SD+1   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

c = plot(showStd ? s1dn : na, title = "VWAP - STDEV -1", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_labels and showStd ?  s1dn : na , "     -------- SD-1   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

d = plot(showStd ? s2dn : na, title = "VWAP - STDEV -2", color = color.new(color.gray, 70), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_labels and showStd ? s2dn : na , "     -------- SD-2   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

fill_col_up = color.new(color.gray, 90)
fill_col_mid = color.new(color.gray, 90)
fill_col_down = color.new(color.gray, 90)

fill(a, b, fill_bands ? fill_col_up : na)
fill(b, c, fill_bands ? fill_col_mid : na)
fill(c, d, fill_bands ? fill_col_down : na)


// ---------- Previous period levels ---------- //

previouslevels(period, VWAP, s2up, s1up, s1dn, s2dn) =>
    var float pV = na
    var float ps2up = na
    var float ps1up = na
    var float ps1dn = na
    var float ps2dn = na
    pV := period ? VWAP[1] : pV
    ps2up := period ? s2up[1] : ps2up
    ps1up := period ? s1up[1] : ps1up
    ps1dn := period ? s1dn[1] : ps1dn
    ps2dn := period ? s2dn[1] : ps2dn

    [ pV, ps2up, ps1up, ps1dn, ps2dn ]

[ pV, ps2up, ps1up, ps1dn, ps2dn ] = previouslevels(prev_period, vwap_sel, s2up, s1up, s1dn, s2dn)

// ---------- Plot previous levels ---------- //

pVplot = plot(plot_pL1 ? pV : na, title = "Previous VWAP", color = color.new(VWAP_RED, 60), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_plabels and plot_pL1 ? pV : na, "--------- pVWAP   ", VWAP_RED, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pa = plot(plot_pL2 ? ps2up : na, title = "Previous VWAP - STDEV +2", color = color.new(color.gray, 70), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_plabels and plot_pL2 ?  ps2up : na , "     -------- pSD+2   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pb = plot(plot_pL1 ? ps1up : na, title = "Previous VWAP - STDEV +1", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_plabels and plot_pL1 ?  ps1up : na , "     -------- pSD+1   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pc = plot(plot_pL1 ? ps1dn : na, title = "Previous VWAP - STDEV -1", color = color.new(color.gray, 60), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_plabels and plot_pL1 ?  ps1dn : na , "     -------- pSD-1   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

pd = plot(plot_pL2 ? ps2dn : na, title = "Previous VWAP - STDEV -2", color = color.new(color.gray, 70), style = plot.style_linebr, linewidth = 1)
f_drawLabel(ll_offset, show_plabels and plot_pL2 ? ps2dn : na , "     -------- pSD-2   ", color.gray, DEFAULT_LABEL_STYLE, DEFAULT_LABEL_SIZE)

fill(pa, pb, fill_pbands ? fill_col_up : na)
fill(pb, pc, fill_pbands ? fill_col_mid : na)
fill(pc, pd, fill_pbands ? fill_col_down : na)
