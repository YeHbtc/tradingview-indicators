indicator("MA+ema", overlay=true, max_labels_count=4)
src = input.source(close, "价格来源", display=display.none)
showSMA = input.bool(true, "SMA", group="SMA", display=display.none)
SMAlen0 = input.int(20, "第1条", minval=1, group="SMA", inline="SMA0", display=display.none)
SMAcol0 = input.color(#b8b8b8, "", group="SMA", inline="SMA0", display=display.none)
SMAval0 = ta.sma(src, SMAlen0)
plot(showSMA ? SMAval0 : na, "SMA 第1条", color=SMAcol0, linewidth=1, display=display.pane)
SMAlen1 = input.int(60, "第2条", minval=1, group="SMA", inline="SMA1", display=display.none)
SMAcol1 = input.color(#FF5252, "", group="SMA", inline="SMA1", display=display.none)
SMAval1 = ta.sma(src, SMAlen1)
plot(showSMA ? SMAval1 : na, "SMA 第2条", color=SMAcol1, linewidth=1, display=display.pane)
SMAlen2 = input.int(120, "第3条", minval=1, group="SMA", inline="SMA2", display=display.none)
SMAcol2 = input.color(#2196F3, "", group="SMA", inline="SMA2", display=display.none)
SMAval2 = ta.sma(src, SMAlen2)
plot(showSMA ? SMAval2 : na, "SMA 第3条", color=SMAcol2, linewidth=1, display=display.pane)
SMAlen3 = input.int(200, "第4条", minval=1, group="SMA", inline="SMA3", display=display.none)
SMAcol3 = input.color(#ffc40c, "", group="SMA", inline="SMA3", display=display.none)
SMAval3 = ta.sma(src, SMAlen3)
plot(showSMA ? SMAval3 : na, "SMA 第4条", color=SMAcol3, linewidth=1, display=display.pane)
showEMA = input.bool(true, "EMA", group="EMA", display=display.none)
EMAlen0 = input.int(21, "第1条", minval=1, group="EMA", inline="EMA0", display=display.none)
EMAcol0 = input.color(#b8b8b8, "", group="EMA", inline="EMA0", display=display.none)
EMAval0 = ta.ema(src, EMAlen0)
plot(showEMA ? EMAval0 : na, "EMA 第1条", color=EMAcol0, linewidth=1, display=display.pane)
EMAlen1 = input.int(55, "第2条", minval=1, group="EMA", inline="EMA1", display=display.none)
EMAcol1 = input.color(#FF5252, "", group="EMA", inline="EMA1", display=display.none)
EMAval1 = ta.ema(src, EMAlen1)
plot(showEMA ? EMAval1 : na, "EMA 第2条", color=EMAcol1, linewidth=1, display=display.pane)
EMAlen2 = input.int(100, "第3条", minval=1, group="EMA", inline="EMA2", display=display.none)
EMAcol2 = input.color(#2196F3, "", group="EMA", inline="EMA2", display=display.none)
EMAval2 = ta.ema(src, EMAlen2)
plot(showEMA ? EMAval2 : na, "EMA 第3条", color=EMAcol2, linewidth=1, display=display.pane)
EMAlen3 = input.int(200, "第4条", minval=1, group="EMA", inline="EMA3", display=display.none)
EMAcol3 = input.color(#ffc40c, "", group="EMA", inline="EMA3", display=display.none)
EMAval3 = ta.ema(src, EMAlen3)
plot(showEMA ? EMAval3 : na, "EMA 第4条", color=EMAcol3, linewidth=1, display=display.pane)

// 仅更新末根K线的标签，关闭组时同时删除标签。
updateLabel(label id, bool enabled, float value, string prefix, int length, color tint, bool bold) =>
    label result = id
    if barstate.islast
        if enabled and not na(value) and value != 0
            string caption = prefix + str.tostring(length) + ": " + str.tostring(value, "#.##") + " (" + str.tostring((close - value) / value * 100, "#.##") + "%)"
            if na(result)
                result := label.new(bar_index + (prefix == "M" ? 3 : 35), value, "", style=label.style_label_left, color=color(na), size=size.normal)
            label.set_xy(result, bar_index + (prefix == "M" ? 3 : 35), value)
            label.set_text(result, caption)
            label.set_textcolor(result, tint)
            label.set_text_formatting(result, bold ? text.format_bold : text.format_none)
        else
            label.delete(result)
            result := na
    result
var label SMAlabel0 = na
SMAlabel0 := updateLabel(SMAlabel0, showSMA, SMAval0, "M", SMAlen0, close >= SMAval0 ? color.green : color.red, true)
var label SMAlabel3 = na
SMAlabel3 := updateLabel(SMAlabel3, showSMA, SMAval3, "M", SMAlen3, chart.fg_color, false)
var label EMAlabel0 = na
EMAlabel0 := updateLabel(EMAlabel0, showEMA, EMAval0, "E", EMAlen0, close >= EMAval0 ? color.green : color.red, true)
var label EMAlabel3 = na
EMAlabel3 := updateLabel(EMAlabel3, showEMA, EMAval3, "E", EMAlen3, chart.fg_color, false)
