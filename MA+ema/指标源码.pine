indicator("MA+ema", overlay=true, max_labels_count=4)
src = input.source(close, "价格来源", display=display.none)
showSMA = input.bool(true, "SMA", group="SMA", inline="SMA开关", display=display.none)
labelsSMA = input.bool(true, "标签", group="SMA", inline="SMA开关", display=display.none)
typeSMA = input.string("实线", "线型", options=["实线", "虚线", "点线"], group="SMA", inline="SMA开关", display=display.none)
widthSMA = input.int(1, "粗细", minval=1, maxval=5, group="SMA", inline="SMA开关", display=display.none)
SMAlen0 = input.int(20, "", minval=1, group="SMA", inline="SMA0", display=display.none)
SMAcol0 = input.color(color.new(#b8b8b8, 50), "", group="SMA", inline="SMA0", display=display.none)
SMAval0 = ta.sma(src, SMAlen0)
plot(showSMA ? SMAval0 : na, "", color=SMAcol0, linewidth=widthSMA, editable=false, linestyle=typeSMA == "虚线" ? plot.linestyle_dashed : typeSMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
SMAlen1 = input.int(60, "", minval=1, group="SMA", inline="SMA1", display=display.none)
SMAcol1 = input.color(color.new(#FF5252, 50), "", group="SMA", inline="SMA1", display=display.none)
SMAval1 = ta.sma(src, SMAlen1)
plot(showSMA ? SMAval1 : na, "", color=SMAcol1, linewidth=widthSMA, editable=false, linestyle=typeSMA == "虚线" ? plot.linestyle_dashed : typeSMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
SMAlen2 = input.int(120, "", minval=1, group="SMA", inline="SMA2", display=display.none)
SMAcol2 = input.color(color.new(#2196F3, 50), "", group="SMA", inline="SMA2", display=display.none)
SMAval2 = ta.sma(src, SMAlen2)
plot(showSMA ? SMAval2 : na, "", color=SMAcol2, linewidth=widthSMA, editable=false, linestyle=typeSMA == "虚线" ? plot.linestyle_dashed : typeSMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
SMAlen3 = input.int(200, "", minval=1, group="SMA", inline="SMA3", display=display.none)
SMAcol3 = input.color(color.new(#ffc40c, 50), "", group="SMA", inline="SMA3", display=display.none)
SMAval3 = ta.sma(src, SMAlen3)
plot(showSMA ? SMAval3 : na, "", color=SMAcol3, linewidth=widthSMA, editable=false, linestyle=typeSMA == "虚线" ? plot.linestyle_dashed : typeSMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
showEMA = input.bool(true, "EMA", group="EMA", inline="EMA开关", display=display.none)
labelsEMA = input.bool(true, "标签", group="EMA", inline="EMA开关", display=display.none)
typeEMA = input.string("实线", "线型", options=["实线", "虚线", "点线"], group="EMA", inline="EMA开关", display=display.none)
widthEMA = input.int(1, "粗细", minval=1, maxval=5, group="EMA", inline="EMA开关", display=display.none)
EMAlen0 = input.int(21, "", minval=1, group="EMA", inline="EMA0", display=display.none)
EMAcol0 = input.color(#b8b8b8, "", group="EMA", inline="EMA0", display=display.none)
EMAval0 = ta.ema(src, EMAlen0)
plot(showEMA ? EMAval0 : na, "", color=EMAcol0, linewidth=widthEMA, editable=false, linestyle=typeEMA == "虚线" ? plot.linestyle_dashed : typeEMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
EMAlen1 = input.int(55, "", minval=1, group="EMA", inline="EMA1", display=display.none)
EMAcol1 = input.color(#FF5252, "", group="EMA", inline="EMA1", display=display.none)
EMAval1 = ta.ema(src, EMAlen1)
plot(showEMA ? EMAval1 : na, "", color=EMAcol1, linewidth=widthEMA, editable=false, linestyle=typeEMA == "虚线" ? plot.linestyle_dashed : typeEMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
EMAlen2 = input.int(100, "", minval=1, group="EMA", inline="EMA2", display=display.none)
EMAcol2 = input.color(#2196F3, "", group="EMA", inline="EMA2", display=display.none)
EMAval2 = ta.ema(src, EMAlen2)
plot(showEMA ? EMAval2 : na, "", color=EMAcol2, linewidth=widthEMA, editable=false, linestyle=typeEMA == "虚线" ? plot.linestyle_dashed : typeEMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)
EMAlen3 = input.int(200, "", minval=1, group="EMA", inline="EMA3", display=display.none)
EMAcol3 = input.color(#ffc40c, "", group="EMA", inline="EMA3", display=display.none)
EMAval3 = ta.ema(src, EMAlen3)
plot(showEMA ? EMAval3 : na, "", color=EMAcol3, linewidth=widthEMA, editable=false, linestyle=typeEMA == "虚线" ? plot.linestyle_dashed : typeEMA == "点线" ? plot.linestyle_dotted : plot.linestyle_solid, style=plot.style_line, display=display.pane)

// 仅更新末根K线的标签，关闭组时同时删除标签。
updateLabel(label id, bool enabled, float value, string prefix, int length, bool bold) =>
    label result = id
    if barstate.islast
        if enabled and not na(value) and value != 0
            string caption = prefix + str.tostring(length) + ": " + str.tostring((close - value) / value * 100, "#.##") + "%"
            if na(result)
                result := label.new(bar_index + 3, value, "", style=label.style_label_left, color=color(na), size=size.normal)
            label.set_xy(result, bar_index + 3, value)
            label.set_text(result, caption)
            label.set_textcolor(result, value > close ? color.red : color.green)
            label.set_text_formatting(result, bold ? text.format_bold : text.format_none)
        else
            label.delete(result)
            result := na
    result
var label SMAlabel0 = na
SMAlabel0 := updateLabel(SMAlabel0, showSMA and labelsSMA, SMAval0, "M", SMAlen0, true)
var label SMAlabel3 = na
SMAlabel3 := updateLabel(SMAlabel3, showSMA and labelsSMA, SMAval3, "M", SMAlen3, false)
var label EMAlabel0 = na
EMAlabel0 := updateLabel(EMAlabel0, showEMA and labelsEMA, EMAval0, "E", EMAlen0, true)
var label EMAlabel3 = na
EMAlabel3 := updateLabel(EMAlabel3, showEMA and labelsEMA, EMAval3, "E", EMAlen3, false)
